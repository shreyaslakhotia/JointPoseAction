# Large datasets (small recording/annotation manifests live in reproducibility/)
/data/

# Video Outputs
/output_*/
/output_visualization.mp4
*.mp4
*.avi
*.mov
*.mkv

# External Cloned Repositories
/assemblyhands-toolkit/
/3D_reconstruction/single_view/sam3d_repo/
# Upstream revisions, custom files, YAMLs and local patches are preserved in
# reproducibility/upstreams/ instead of committing whole third-party clones.
# Keep the small original mistake CSV snapshots, not an external repository.
/mistake_repo/*
!/mistake_repo/README.md
!/mistake_repo/annots/
/mistake_repo/annots/*
!/mistake_repo/annots/*.csv

